{
  "name": "xeno-ai-campaign-copilot",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,crm,channel -c cyan,green,magenta \"npm run dev -w apps/web\" \"npm run dev -w apps/crm-api\" \"npm run dev -w apps/channel-service\"",
    "build": "npm run build -ws",
    "typecheck": "npm run typecheck -ws",
    "db:seed": "npm run seed -w packages/database"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "browserslist": "^4.28.2",
    "caniuse-lite": "^1.0.30001799",
    "form-data": "^4.0.6",
    "next": "^16.2.9",
    "proxy-from-env": "^2.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "update-browserslist-db": "^1.2.3"
  }
}
